package views

import "github.com/VOVOplay/creatorcoaster.com/src/myTypes"
import "fmt"
import "slices"
import "cmp"

func sortBlogPosts(allBlogs []myTypes.Article) []myTypes.Article {
    // https://pkg.go.dev/slices#SortFunc
    slices.SortFunc(allBlogs, func(a myTypes.Article, b myTypes.Article) int {
        return cmp.Compare(b.Info.Date, a.Info.Date)
    })

    return allBlogs
}

templ BlogLandingPage(allBlogs []myTypes.Article, databaseOkay bool) {
    @Layout("Blog | Creator Coaster") {
        <div class="free-area-for-text">
            <div class="text-div">
                <h1 class="cc-blog-heading">Creator Coaster Blog</h1>
                // ---
                if databaseOkay {
                    <div class="blog-cards">
                        {{ sortedBlogs := sortBlogPosts(allBlogs) }}
                        for _, blog := range sortedBlogs {
                            {{ blogURL := fmt.Sprintf("/blog/%v", blog.Name) }}

                            <a href={ blogURL }>
                                <div class="blog-card">
                                    <div class="top-section">
                                        <span class="blog-card-heading"> { blog.PrettyName } </span>
                                        <div class="author-section"><img src= { blog.Info.AuthorPFPLink }> { blog.Info.Author }</div>
                                    </div>
                                    <div class="bottom-section">
                                        <div class="date"><img src="/static/assets/calendar.svg">{ formatUnixTime(blog.Info.Date) }</div>
                                        <div class="vertical-separator"></div>
                                        <div class="read-time"><img src="/static/assets/clock.svg">{ blog.Info.ReadTime }</div>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                } else {
                    Sorry, we could not load the blogs at this moment. Try again later.
                }
            </div>
        </div>
    }
}