                </div>
            }
        </div>
    }
}

// --- VARIABLES

templ StandardVariableCard(variable myTypes.Variable) {
    {{
        cardID := fmt.Sprintf("admin-variable-card-%v", variable.VariableName)
        cardTargetID := fmt.Sprintf("#%v", cardID)
        actionsID := fmt.Sprintf("actions-%v", variable.VariableName) 
        actionsTargetID := fmt.Sprintf("#%v", actionsID)
    }}
    <div class="admin-article-card" id={ cardID }>
        <div class="info">
        { variable.VariableName }: <code class="md-inline-code">{ variable.VariableContents }</code>
        </div>
        <div class="actions" id={ actionsID }>
            {{
                editURL := fmt.Sprintf("/api/admin/show-edit-variable-card?name=%v&type=%v", variable.VariableName, myTypes.KindStandardVariable)
                deleteURL := fmt.Sprintf("/api/admin/delete-variable?name=%v&type=%v&confirmed=no", variable.VariableName, myTypes.KindStandardVariable)
            }}
            <a hx-get={ editURL } hx-target={ cardTargetID }>Edit</a> | <a hx-delete={ deleteURL } hx-target={ actionsTargetID }>Delete</a>
        </div>
    </div>
}

