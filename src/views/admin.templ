package views

import "github.com/VOVOplay/creatorcoaster.com/src/myTypes"
import "fmt"

templ Admin(loggedIn bool) {
    @Layout("Admin | Creator Coaster") {
        if !loggedIn {
            <div class="text-div">
                <a href="https://discord.com/oauth2/authorize?client_id=1478409762042413126&response_type=code&redirect_uri=http%3A%2F%2F127.0.0.1%3A7331%2Fauth%2Fdiscord%2Fcallback&scope=identify">Log in</a>
            </div>
        } else {
            @AdminLoggedInView()
        }
    }
}


templ AdminLoggedInView() {
    <div class="text-div">
        <a href="/admin/upload-wiki">Upload Wiki Article</a> | <a href="/admin/manage-wiki">Manage Wiki</a>
        <br>
        <a href="/admin/upload-blog">Upload Blog Post</a> | <a href="/admin/manage-blog">Manage Blog Posts</a>
        <br>
        <a href="/admin/upload-variable">Upload New Variable</a> | <a href="/admin/manage-variable">Manage Variables</a>
        <hr>
        <a href="/auth/discord/logout">Log out</a>
    </div> 
}

// --- WIKI

// This component serves both for uploading and editing wiki articles. However the API is seperate
templ EditSpecificWikiArticle(wikiArticle myTypes.Article) {
    @Layout("Upload Wiki | Admin | Creator Coaster") {
        {{
            isNewArticle := wikiArticle == myTypes.Article{}

            heading := "Wiki Upload"
            if !isNewArticle {
                heading = "Edit Wiki Article"
            }

            API := "/api/admin/upload-wiki"
            if !isNewArticle {
                API = "/api/admin/update-wiki"
            }

            var previousName string
            if !isNewArticle {
                previousName = wikiArticle.Name
            }

            // These values will be an empty string if it's a new article, therefore we can use them in the HTML even if it's a new article
            var nameValue string
            var prettyNameValue string
            var categoryPathValue string
            var sortOrderValue int
            var markdownSourceValue string
            if !isNewArticle {
                nameValue = wikiArticle.Name
                prettyNameValue = wikiArticle.PrettyName
                categoryPathValue = wikiArticle.CategoryPath
                sortOrderValue = wikiArticle.SortOrder
                markdownSourceValue = wikiArticle.MarkdownSource
            }

        }}
        <div class="fill-screen-div">
            <div class="admin-half-page left">
                <a href="javascript:history.back()">Go back</a>
                <h2 class="md-heading">{ heading }</h2>
                <form hx-post={ API } hx-target="#response-section" hx-swap="innerHTML" class="admin-form">
                    // Hidden field for the old name
                    if !isNewArticle {
                        <input class="hidden" type="text" id="previous-name" name="previous-name" value={ previousName } required>
                    }

                    <div>
                        <label for="name">Name (not pretty):</label>
                        <br>
                        <input type="text" id="name" name="name" value={ nameValue } required>
                    </div>
                    <div>
                        <label for="pretty-name">Pretty Name:</label>
                        <br>
                        <input type="text" id="pretty-name" name="pretty-name" value={ prettyNameValue } required>
                    </div>
                    <div>
                        <label for="category-path">Category Path:</label>
                        <br>
                        <input type="text" id="category-path" name="category-path" value={ categoryPathValue } required>
                    </div>
                    <div>
                        <label for="sort-order">Sort order (in its category):</label>
                        <br>
                        <input type="number" id="sort-order" name="sort-order" value={ sortOrderValue } required>
                    </div>

                    <div>
                        <label for="md-source">MD Source:</label>
                        <br>
                        <textarea id="md-source" name="md-source" required>{ markdownSourceValue }</textarea>     
                    </div>
                
                    <button hx-post="/api/admin/preview-wiki" hx-target="#preview-contents" hx-swap="innerHTML" class="preview-button">Preview</button> | <button type="submit" class="submit-button">Submit</button>
                </form>
                <div id="response-section"></div>
            </div>
            <div class="admin-half-page">
                <div class="free-area-for-text">
                    <div class="text-div">
                        <div id="preview-contents">
                            <h2 class="md-heading">Preview Section</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

templ ManageWikiView(allWikiArticles []myTypes.Article) {
    @Layout("Manage Wiki Articles | Admin | Creator Coaster") {
        <div class="text-div">
            <a href="javascript:history.back()">Go back</a>
            for _, wikiArticle := range allWikiArticles {
                {{ 
                    adminArticleCardID := fmt.Sprintf("admin-article-card-%v", wikiArticle.Name)
                    actionsID := fmt.Sprintf("actions-%v", wikiArticle.Name) 
                    actionsTargetID := fmt.Sprintf("#%v", actionsID)
                }}
                <div class="admin-article-card" id={ adminArticleCardID }>
                    <div class="info">
                        { wikiArticle.PrettyName } (<code class="md-inline-code">{ wikiArticle.Name }</code>)
                    </div>
                    
                    <div id={ actionsID }>
                        {{
                            editURL := fmt.Sprintf("/admin/update-wiki?name=%v", wikiArticle.Name)
                            deleteURL := fmt.Sprintf("/api/admin/delete-wiki?name=%v&confirmed=no", wikiArticle.Name)
                        }}
                        <a href={ editURL }>Edit</a> | <a hx-delete={ deleteURL } hx-target={ actionsTargetID }>Delete</a>
                    </div>
                </div>
            }
        </div>
    }
}
// --- BLOGS

type AuthorPFPCombination struct {
    AuthorName string
    PFPLink string
}

func (combination AuthorPFPCombination) isUnique(fullList []AuthorPFPCombination) bool {
    for _, existingAuthorPFPCombination := range fullList {
        if combination == existingAuthorPFPCombination {
            return false
        }
    }

    return true
}

func getListOfCombinations(allBlogs []myTypes.Article) []AuthorPFPCombination {
    fullList := []AuthorPFPCombination{}

    for _, blog := range allBlogs {
        authorPFPCombination := AuthorPFPCombination{
            AuthorName: blog.Info.Author,
            PFPLink: blog.Info.AuthorPFPLink,
        }

        if authorPFPCombination.isUnique(fullList) {
            fullList = append(fullList, authorPFPCombination)
        }
    }

    return fullList
} 

templ UploadBlogView(allBlogs []myTypes.Article) {
    @Layout("Upload Blog | Admin | Creator Coaster") {
        <div class="fill-screen-div">
            <div class="admin-half-page left">
                <a href="javascript:history.back()">Go back</a>
                <h2 class="md-heading">Blog Upload</h2>
                <form hx-post="/api/admin/upload-blog" hx-target="#response-section" hx-swap="innerHTML" class="admin-form">
                    <div>
                        <label for="name">Name (not pretty):</label>
                        <br>
                        <input type="text" id="name" name="name" required>
                    </div>
                    <div>
                        <label for="pretty-name">Pretty Name:</label>
                        <br>
                        <input type="text" id="pretty-name" name="pretty-name" required>
                    </div>
                    <div>
                        <label for="author">Author:</label>
                        <br>
                        <input type="text" id="author" name="author" required>
                    </div>
                    <div>
                        <label for="author-pfp-link">Author PFP Link:</label>
                        <br>
                        <input type="text" id="author-pfp-link" name="author-pfp-link" required>
                    </div>

                    <div>
                        <label for="md-source">MD Source:</label>
                        <br>
                        <textarea id="md-source" name="md-source" required></textarea>     
                    </div>
                
                    <button hx-post="/api/admin/preview-blog" hx-target="#preview-contents" hx-swap="innerHTML" class="preview-button">Preview</button> | <button type="submit" class="submit-button">Submit</button>
                </form>
                <div id="response-section"></div>
                <h3 class="md-heading">Previously used name-pfp combinations:</h3>
                {{ fullList :=  getListOfCombinations(allBlogs) }}

                for _, combination := range fullList {
                    <code class="md-inline-code">{combination.AuthorName}</code> - <code class="md-inline-code">{combination.PFPLink}</code>
                }
            </div>
            <div class="admin-half-page">
                <div class="free-area-for-text">
                    <div class="text-div">
                        <div id="preview-contents">
                            <h2 class="md-heading">Preview Section</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}