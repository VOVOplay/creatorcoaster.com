templ ManageVariablesView(standardVariables []myTypes.Variable, channelVariables []myTypes.ChannelVariable, roleUserVariables []myTypes.RoleUserVariable, errors []error) {
    @Layout("Manage Variables | Admin | Creator Coaster") {
        <div class="full-screen-div">
            <h1 class="md-heading">Manage Variables</h1>
            <a href="javascript:history.back()">Go back</a>
            if errors != nil {
                <br>
                Encountered errors:
                <br>
                for i, err := range errors {
                    { i + 1 }: { err.Error() }<br>
                }
            }
            <hr class="md-hr">
            <div id="admin-variable-sections-holder">
                <div class="variable-holder right-border">
                    <h4 class="md-heading">Standard Variables</h4>
                    {{
                        editURL := fmt.Sprintf("/api/admin/show-edit-variable-card?type=%v", myTypes.KindStandardVariable)
                    }}
                    <a hx-get={ editURL } hx-target="#standard-variables-list" hx-swap="afterbegin">Upload New</a>
                    <div id="standard-variables-list"></div>
                    for _, variable := range standardVariables {
                        @StandardVariableCard(variable)
                    }
                </div>
                <div class="variable-holder right-border">
                    <h4 class="md-heading">Channel Variables</h4>
                    {{
                        editURL = fmt.Sprintf("/api/admin/show-edit-variable-card?type=%v", myTypes.KindChannelVariable)
                    }}
                    <a hx-get={ editURL } hx-target="#channel-variables-list" hx-swap="afterbegin">Upload New</a>
                    <div id="channel-variables-list"></div>
                    for _, channelVariable := range channelVariables {
                        @ChannelVariableCard(channelVariable)
                    }
                </div>
                <div class="variable-holder">
                    <h4 class="md-heading">Role/User Variables</h4>
                    {{
                        editURL = fmt.Sprintf("/api/admin/show-edit-variable-card?type=%v", myTypes.KindRoleUserVariable)
                    }}
                    <a hx-get={ editURL } hx-target="#role-user-variables-list" hx-swap="afterbegin">Upload New</a>
                    <div id="role-user-variables-list"></div>
                    for _, roleUserVariable := range roleUserVariables {
                        @RoleUserVariableCard(roleUserVariable)
                    }
                </div>
            </div>
        </div>
    }
}

templ EditStandardVariableCard(variable myTypes.Variable) {
    {{
        isNewVariable := variable == myTypes.Variable{}

        var previousName string
        if !isNewVariable {
            previousName = variable.VariableName
        }
        
        API := fmt.Sprintf("/api/admin/upload-variable?type=%v", myTypes.KindStandardVariable)
        if !isNewVariable {
            API = fmt.Sprintf("/api/admin/update-variable?type=%v", myTypes.KindStandardVariable)
        }

        hxTarget := "this"
        hxSwap := "outerHTML"
        if !isNewVariable {
            hxTarget = fmt.Sprintf("#admin-variable-card-%v", variable.VariableName)
            hxSwap = "outerHTML"
        }

        var nameValue string
        var contentsValue string
        if !isNewVariable {
            nameValue = variable.VariableName
            contentsValue = variable.VariableContents
        }
    }}
    <form hx-post={ API } hx-target={ hxTarget } hx-swap={ hxSwap } class="admin-form">
        // Hidden field for the old name
        if !isNewVariable {
            <input class="hidden" type="text" id="previous-name" name="previous-name" value={ previousName } required>
        }

        <div>
            <label for="variable-name">Variable Name:</label>
            <br>
            <input type="text" id="variable-name" name="variable-name" value={ nameValue } required>
        </div>
        <div>
            <label for="contents">Variable Contents:</label>
            <br>
            <input type="text" id="contents" name="contents" value={ contentsValue } required>
        </div>
    
        <button type="submit" class="submit-button">Submit</button>
    </form>
}

templ EditChannelVariableCard(channelVariable myTypes.ChannelVariable) {
    {{
        isNewVariable := channelVariable == myTypes.ChannelVariable{}

        var previousName string
        if !isNewVariable {
            previousName = channelVariable.VariableName
        }
        
        API := fmt.Sprintf("/api/admin/upload-variable?type=%v", myTypes.KindChannelVariable)
        if !isNewVariable {
            API = fmt.Sprintf("/api/admin/update-variable?type=%v", myTypes.KindChannelVariable)
        }

        hxTarget := "this"
        hxSwap := "outerHTML"
        if !isNewVariable {
            hxTarget = fmt.Sprintf("#admin-channel-variable-card-%v", channelVariable.VariableName)
            hxSwap = "outerHTML"
        }

        var nameValue string
        var channelIDValue uint64
        var channelNameValue string
        if !isNewVariable {
            nameValue = channelVariable.VariableName
            channelIDValue = channelVariable.ID
            channelNameValue = channelVariable.ChannelName
        }
    }}
    <form hx-post={ API } hx-target={ hxTarget } hx-swap={ hxSwap } class="admin-form">
        // Hidden field for the old name
        if !isNewVariable {
            <input class="hidden" type="text" id="previous-name" name="previous-name" value={ previousName } required>
        }

        <div>
            <label for="variable-name">Variable Name:</label>
            <br>
            <input type="text" id="variable-name" name="variable-name" value={ nameValue } required>
        </div>
        <div>
            <label for="channel-id">Channel ID:</label>
            <br>
            if channelIDValue == 0 {
                <input type="text" id="channel-id" name="channel-id" required>
            } else {
                <input type="text" id="channel-id" name="channel-id" value={ channelIDValue } required>
            }
            
        </div>
        <div>
            <label for="channel-name">Channel Name:</label>
            <br>
            <input type="text" id="channel-name" name="channel-name" value={ channelNameValue } required>
        </div>
    
        <button type="submit" class="submit-button">Submit</button>
    </form>
}

templ EditRoleUserVariableCard(roleUserVariable myTypes.RoleUserVariable) {
    {{
        isNewVariable := roleUserVariable == myTypes.RoleUserVariable{}

        var previousName string
        if !isNewVariable {
            previousName = roleUserVariable.VariableName
        }
        
        API := fmt.Sprintf("/api/admin/upload-variable?type=%v", myTypes.KindRoleUserVariable)
        if !isNewVariable {
            API = fmt.Sprintf("/api/admin/update-variable?type=%v", myTypes.KindRoleUserVariable)
        }

        hxTarget := "this"
        hxSwap := "outerHTML"
        if !isNewVariable {
            hxTarget = fmt.Sprintf("#admin-role-user-variable-card-%v", roleUserVariable.VariableName)
            hxSwap = "outerHTML"
        }

        var nameValue string
        var roleUserIDValue uint64
        var roleUserNameValue string
        roleUserType := myTypes.User
        if !isNewVariable {
            nameValue = roleUserVariable.VariableName
            roleUserIDValue = roleUserVariable.ID
            roleUserNameValue = roleUserVariable.RoleUserName
            roleUserType = roleUserVariable.Type
        }
    }}
    <form hx-post={ API } hx-target={ hxTarget } hx-swap={ hxSwap } class="admin-form">
        // Hidden field for the old name
        if !isNewVariable {
            <input class="hidden" type="text" id="previous-name" name="previous-name" value={ previousName } required>
        }

        <div>
            <label for="variable-name">Variable Name:</label>
            <br>
            <input type="text" id="variable-name" name="variable-name" value={ nameValue } required>
        </div>
        <div>
            <label for="role-user-id">Role/User ID:</label>
            <br>
            if roleUserIDValue == 0 {
                <input type="text" id="role-user-id" name="role-user-id" required>
            } else {
                <input type="text" id="role-user-id" name="role-user-id" value={ roleUserIDValue } required>
            }
        </div>
        <div>
            <label for="role-user-name">Role/User name:</label>
            <br>
            <input type="text" id="role-user-name" name="role-user-name" value={ roleUserNameValue } required>
        </div>
        <div>
            <label for="type">Type (Role or User):</label>
            <br>
            <select name="type" id="type" required>
                if roleUserType == myTypes.User {
                    <option value={ myTypes.User }>User</option>
                    <option value={ myTypes.Role }>Role</option>
                } else {
                    <option value={ myTypes.Role }>Role</option>
                    <option value={ myTypes.User }>User</option>
                }
            </select>
        </div>
        <button type="submit" class="submit-button">Submit</button>
    </form>
}