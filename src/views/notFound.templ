package views

templ NotFound() {
    @Layout("404 | Creator Coaster") {
        <div class="fill-screen-div">
            <div id="not-found-section">
                <img src="/static/assets/sad-cc.png">
                <h1>404</h1>
                <p>We could not find what you were looking for :(</p>
                <a href="/"><button>Go home</button></a>
            </div>
        </div>
    }
}